{
  "manifest_version": 3,
  "name": "Rewind for Facebook",
  "short_name": "Rewind",
  "version": "0.2.0",
  "description": "See the first posts and reels of any Facebook page, oldest first, or jump to any date. Not affiliated with Meta.",
  "homepage_url": "https://github.com/elieatt/rewindfb",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Rewind",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
